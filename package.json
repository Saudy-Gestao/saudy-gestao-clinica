{
  "name": "saudy-gestao-clinica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sistema de gestão clínica Saudy",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "e2e:prepare": "node e2e/prepare-e2e.mjs",
    "e2e": "yarn e2e:prepare && playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "yarn e2e:prepare && playwright test -c e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:db:down": "node e2e/prepare-e2e.mjs --down",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.95.2",
    "@tinymce/tinymce-react": "^5.1.1",
    "@types/react-grid-layout": "^1.3.6",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cornerstone-core": "^2.6.1",
    "cornerstone-math": "^0.1.10",
    "cornerstone-tools": "^6.0.10",
    "cornerstone-wado-image-loader": "^4.13.2",
    "dayjs": "^1.11.19",
    "dicom-parser": "^1.8.21",
    "hammerjs": "^2.0.8",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.3",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^1.0.0"
  }
}
